# ============================================================
# Legrand GeoAI — Variables d'environnement
# ============================================================
# Copier ce fichier : cp .env.example .env
# Puis modifier les valeurs selon votre environnement
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=geoai
POSTGRES_PASSWORD=changez_moi_en_production
POSTGRES_DB=legrand_geoai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Hatchet (orchestration du pipeline documentaire) ---
# Mot de passe de la base PostgreSQL dédiée à Hatchet (conteneur hatchet-postgres)
HATCHET_PG_PASSWORD=changez_moi_en_production
# Jeton du worker — à générer APRÈS le 1er démarrage :
#   make hatchet-token   (puis coller la valeur ici)
HATCHET_CLIENT_TOKEN=
# Adresse gRPC du moteur Hatchet (interne Docker)
HATCHET_CLIENT_HOST_PORT=hatchet:7077
# Pas de TLS en interne on-premise
HATCHET_CLIENT_TLS_STRATEGY=none

# --- JWT Authentication ---
JWT_SECRET_KEY=changez_cette_cle_secrete_en_production_minimum_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Ollama (LLM local) ---
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:32b
EMBED_MODEL=bge-m3
# Fenêtre de contexte LLM (doit englober contexte RAG + réponse).
LLM_NUM_CTX=12288
LLM_MAX_TOKENS=1536

# --- Reranker ---
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# --- RAG (gating de pertinence + sélection de document + parent-document) ---
RAG_N_RETRIEVE=40
RAG_N_RERANK=20
RERANK_SCORE_GAP=0.15
RERANK_SCORE_FLOOR=0.02
DOC_SELECT_MARGIN=0.10
MAX_SELECTED_DOCS=3
MAX_DOC_CHUNKS=16
MAX_CONTEXT_CHUNKS=16
NEIGHBOR_WINDOW=2

# --- Extraction documentaire (Docling) ---
DOCLING_ARTIFACTS_PATH=/opt/docling-models
OCR_LANGS=fr,en
VLM_FALLBACK_ENABLED=true
VLM_MODEL=qwen3-vl:8b
VLM_MIN_CHARS_PER_PAGE=40

# --- ChromaDB ---
CHROMA_PERSIST_DIR=/data/chromadb

# --- Stockage fichiers ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=50

# --- Admin initial ---
ADMIN_EMAIL=admin@legrand-geoai.local
ADMIN_PASSWORD=changez_moi_en_production
ADMIN_FULL_NAME=Administrateur

# --- Logging ---
LOG_LEVEL=info

# --- Caddy ---
CADDY_DOMAIN=localhost
